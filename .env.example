# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# ===========================================
# Wallet & Auth (Privy + Alchemy)
# ===========================================

# Privy auth (required for wallet login — without these, Connect is a no-op stub)
# Get values from https://dashboard.privy.io — also set on Vercel for production
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Alchemy API key for embedded smart wallet + blockchain reads
VITE_ALCHEMY_API_KEY=
VITE_ALCHEMY_POLICY_ID=

# ===========================================
# Server/API Configuration
# ===========================================

# Privy server credentials (JWT verify + Earn vault actions)
# PRIVY_APP_ID should match VITE_PRIVY_APP_ID
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Earn vault from Privy Dashboard (Wallet infrastructure > Earn)
PRIVY_EARN_VAULT_ID=vault_hls023z3qxu3k0tpklu7sy5w


# CRTVAIx / Superfluid (Live AI streaming)
VITE_CRTVAIX_ADDRESS=
VITE_SUPERFLUID_RECEIVER=

# Unlock Protocol
VITE_PIXELS_PREMIUM_LOCK_ADDRESS=

# Coinbase CDP On-ramp (server-side secrets — Secret API Key ID + Secret, not Client API Key)
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=
# Optional: set to "true" for Headless Onramp sandbox (sandbox- partnerUserRef + fake pay sheet)
# VITE_ONRAMP_SANDBOX=true
# Optional override for onramp API host (defaults to same-origin /api/onramp-*)
# VITE_ONRAMP_API_URL=

# Creative Director / Pixels Plan / Flow (Vertex — server-only)
# Engine: projects/creative-ai-491118/locations/us-east1/reasoningEngines/7129954674127405056
# Agent runtime SA (identity of the engine, not the API caller):
#   service-1037240986506@gcp-sa-aiplatform-re.iam.gserviceaccount.com
# Prefer Workload Identity Federation (no service-account keys).
# Setup: https://vercel.com/docs/oidc/gcp
#
# Production (Vercel) checklist — set ALL of these for Production:
#   GCP_PROJECT_NUMBER                      (IAM & Admin → Settings)
#   GCP_WORKLOAD_IDENTITY_POOL_ID           (e.g. vercel)
#   GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID  (e.g. vercel)
#   GCP_SERVICE_ACCOUNT_EMAIL               (caller SA you create, NOT the Agent Engine SA)
#   GCP_AUDIENCE   (recommended; https OIDC aud from provider "Default audience")
#   GOOGLE_CLOUD_PROJECT or GCP_PROJECT_ID  (e.g. creative-ai-491118)
# Missing any of the four required WIF vars → POST /api/director and POST /api/seedance-plan
#   return 503 naming the missing keys.
#
# GCP provider setup notes (same page as Vercel docs):
# - Issuer: Team mode https://oidc.vercel.com/[TEAM_SLUG] (preferred) or Global https://oidc.vercel.com
# - Audience: select Default audience, copy https URL into GCP_AUDIENCE
# - Attribute mapping: google.subject = assertion.sub
# - SA user principal (replace TEAM/PROJECT/ENV):
#   principal://iam.googleapis.com/projects/GCP_PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/subject/owner:TEAM_SLUG:project:VERCEL_PROJECT_NAME:environment:production
# - Grant the caller SA Vertex AI access (e.g. roles/aiplatform.user), not only Storage
#
# When creating the OIDC provider, select "Default audience", then copy that https URL
# into GCP_AUDIENCE. It is only the Vercel OIDC token aud. STS token exchange uses
# the provider resource name //iam.googleapis.com/projects/NUMBER/.../providers/ID,
# derived from the pool settings below. Do not put that // resource name in GCP_AUDIENCE.
#
# Local without Vercel OIDC: `gcloud auth application-default login` (ADC).
# Local with WIF vars from `vercel env pull`: still use ADC — GCP_* are only
# used for WIF when VERCEL=1 (deployed). Expired VERCEL_OIDC_TOKEN is ignored locally.
GOOGLE_CLOUD_PROJECT=creative-ai-491118
VERTEX_LOCATION=us-east1
VERTEX_REASONING_ENGINE_ID=7129954674127405056
# Optional: route /api/director to ADK api_server on Cloud Run instead of Vertex Agent Engine.
# DIRECTOR_ADK_BASE_URL=https://creative-director-1037240986506.us-east1.run.app
# DIRECTOR_ADK_APP_NAME=agent
# Project number for WIF (creative-ai-491118 → 1037240986506)
# GCP_PROJECT_NUMBER=1037240986506
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# OIDC aud from the GCP provider details page (https, not the // STS resource name), e.g.
# https://iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID
# GCP_AUDIENCE=
# Optional shared secret for non-browser callers (curl, automation). On Vercel,
# browser requests from the same deployment host are allowed without it.
# DIRECTOR_API_SECRET=
# Named Firestore DB for Director sessions / storyboards / payment audit (REST).
# FIRESTORE_DATABASE_ID=creative-director-1
# Set to 1 to skip Firestore writes/reads (Agent Engine chat still works).
# DIRECTOR_FIRESTORE_DISABLED=1

# Director billing (CRTVAI per minute of timeline audio)
# On Vercel, payment is enforced when a treasury address is set.
# Client pays CRTVAI to VITE_SUPERFLUID_RECEIVER (or PIXELS_TREASURY_ADDRESS).
# PIXELS_TREASURY_ADDRESS=
# Set DIRECTOR_BILLING_SOFT=1 to skip on-chain payment verification (dev only).
# DIRECTOR_BILLING_SOFT=1

# Creative Pixels — Seedance 2.5 text-to-video (feature-flagged)
# Client + server: set both to enable the Pixels tab in AI sidebar.
# VITE_ENABLE_SEEDANCE_GENERATE=1
# SEEDANCE_GENERATE_ENABLED=1
# Higgsfield API (server-only — never expose to the browser)
# HIGGSFIELD_KEY_ID=
# HIGGSFIELD_KEY_SECRET=
# Or combined: HIGGSFIELD_CREDENTIALS=KEY_ID:KEY_SECRET
# Local mock without a real key (returns a sample MP4):
# HIGGSFIELD_MOCK=1
# HIGGSFIELD_MOCK_VIDEO_URL=https://example.com/sample.mp4