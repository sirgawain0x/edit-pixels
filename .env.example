# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# ===========================================
# Wallet & Auth (Privy + Alchemy)
# ===========================================

# Privy auth (required for wallet login — without these, Connect is a no-op stub)
# Get values from https://dashboard.privy.io — also set on Vercel for production
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Alchemy API key for embedded smart wallet + blockchain reads
VITE_ALCHEMY_API_KEY=
VITE_ALCHEMY_POLICY_ID=

# ===========================================
# Server/API Configuration
# ===========================================

# CRTVAIx / Superfluid (Live AI streaming)
VITE_CRTVAIX_ADDRESS=
VITE_SUPERFLUID_RECEIVER=

# Unlock Protocol
VITE_PIXELS_PREMIUM_LOCK_ADDRESS=

# Coinbase CDP On-ramp (server-side secrets)
COINBASE_CDP_API_KEY_ID=
COINBASE_CDP_API_KEY_SECRET=

# Creative Director (Vertex Agent Engine SSE proxy — server-only)
# Prefer Workload Identity Federation (no service-account keys).
# Setup: https://vercel.com/docs/oidc/gcp
# When creating the OIDC provider, select "Default audience", then copy that URL
# into GCP_AUDIENCE and pass the same value to getVercelOidcToken({ audience }).
#
# Local without Vercel OIDC: `gcloud auth application-default login` (ADC).
# Local with WIF: `vercel env pull` then the GCP_* vars below.
GOOGLE_CLOUD_PROJECT=1037240986506
VERTEX_LOCATION=us-central1
VERTEX_REASONING_ENGINE_ID=5922098819817799680
# GCP_PROJECT_NUMBER=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Default audience from the GCP provider details page, e.g.
# https://iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID
# GCP_AUDIENCE=
