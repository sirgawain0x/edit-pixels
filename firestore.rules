rules_version = '2';

// Deny-all for client access.
// All Director data (director_sessions, director_storyboards,
// director_payments, director_turns) is read/written only by server routes
// using a service account. Admin access bypasses these rules, so clients get
// no direct access. If a Firebase web SDK is added later, add owner-scoped
// read rules then.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
